{
  "name": "chordsheetjs",
  "author": "Martijn Versluis",
  "version": "12.0.0",
  "description": "A JavaScript library for parsing and formatting chord sheets",
  "source": "src/index.ts",
  "main": "lib/index.js",
  "module": "lib/module.js",
  "types": "lib/main.d.ts",
  "files": [
    "/lib"
  ],
  "bundle": {
    "default": "lib/bundle.js",
    "minified": "lib/bundle.min.js",
    "globalName": "ChordSheetJS"
  },
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/martijnversluis/ChordSheetJS.git"
  },
  "bugs": {
    "url": "https://github.com/martijnversluis/ChordSheetJS/issues"
  },
  "homepage": "https://github.com/martijnversluis/ChordSheetJS",
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@eslint/core": "^0.12.0",
    "@eslint/js": "^9.11.0",
    "@martijnversluis/unibuild": "1.3.0",
    "@parcel/packager-ts": "^2.13.3",
    "@parcel/transformer-typescript-types": "^2.13.3",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^27.4.1",
    "@types/node": "^22.0.0",
    "concat-md": "^0.5.1",
    "detect-newline": "^4.0.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.11.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-jest": "^28.8.3",
    "globals": "^16.0.0",
    "parcel": "^2.13.3",
    "peggy": "^4.0.2",
    "pegjs-backtrace": "^0.2.1",
    "print": "^1.2.0",
    "puppeteer": "^24.0.0",
    "shx": "^0.3.4",
    "theredoc": "^1.0.0",
    "ts-pegjs": "^3.0.0",
    "tsx": "^4.10.5",
    "typedoc": "^0.27.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.6.0"
  },
  "scripts": {
    "build": "bun unibuild",
    "build:release": "bun unibuild --force --release",
    "ci": "bun unibuild ci",
    "debug:chord": "bun run build && bun script/debug_parser.ts chord",
    "debug:chordpro": "bun run build && bun script/debug_parser.ts chord_pro",
    "debug:chords-over-words": "bun run build && bun script/debug_parser.ts chords_over_words --include-chord-grammar",
    "eslint": "node_modules/.bin/eslint",
    "lint": "bun unibuild lint",
    "prepare": "bun run build",
    "release": "bun unibuild release",
    "test": "bun unibuild lint && bun unibuild test",
    "unibuild": "bun unibuild.ts"
  }
}
